    },
    {
      "goal": "验证自定义 JSONL CLI 生命周期",
      "status": "supported",
      "modules": ["sandbox", "driver:JsonlProcess"],
      "recipe": "sandbox-jsonl"
    },
    {
      "goal": "验证模型 wire 与工具轮次",
      "status": "supported",
      "modules": ["llm-fixture:FakeProviderBackend"],
      "recipe": "fixture-backend"
    },
    {
      "goal": "比较多个 driver 和 prompt 变体",
      "status": "supported",
      "modules": ["driver", "matrix", "observation"],
      "recipe": "matrix-report"
    },
    {
      "goal": "用 fake provider 驱动真实 headless Agent CLI",
      "status": "conditional",
      "modules": ["sandbox", "llm-fixture", "harness:createHarnessDriver"],
