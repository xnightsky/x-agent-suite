        "消费者 HarnessProfile",
        "消费者 MCP server 入口",
        "已安装宿主 CLI"
      ],
      "recipe": "headless-fixture"
    },
    {
      "goal": "验证同一会话多轮与入站事件",
      "status": "conditional",
      "modules": ["contracts:LongLivedAgentDriver"],
      "requires": ["消费者长驻 driver 实现"],
      "recipe": "long-lived"
    },
    {
      "goal": "复用 JSON-RPC 长驻 wire 基座并注入协议 adapter",
      "status": "conditional",
      "modules": ["driver:JsonRpcPeer", "driver:LongLivedJsonRpcDriver"],
      "requires": [
        "消费者 JsonRpcLongLivedAdapter 实现",
        "宿主 JSON-RPC over stdio 通道"
      ],
      "recipe": "long-lived-wire"
    },
    {
      "goal": "覆盖 TUI 审批或交互门槛",
      "status": "conditional",
      "modules": ["driver:PtyProcess", "harness:createPtyAgentDriver"],
      "requires": ["PTY 原生依赖", "消费者 PTY profile", "隔离授权"],
      "recipe": "pty"
    },
    {
      "goal": "用 Pi 实证真实 PTY 宿主路径且保持零 token",
      "status": "conditional",
      "modules": [
        "llm-fixture:FakeProviderBackend",
        "harness:createPtyAgentDriver"
      ],
      "requires": ["已安装 Pi CLI", "PTY 原生依赖", "E2E_PI_PTY=1"],
      "recipe": "pi-pty-integration"
    },
    {
      "goal": "验证 live 默认阻断与脱敏",
      "status": "conditional",
      "modules": ["llm-fixture:redactLiveSecrets"],
      "requires": ["无；默认不出网"],
      "recipe": "live-guard"
    },
    {
      "goal": "对照真实模型渠道的 tool calling",
      "status": "conditional",
      "modules": ["llm-fixture:sniffLiveChannel"],
      "requires": ["显式授权", "专用凭据", "费用和出站限制"],
      "recipe": "live-token-smoke"
    },
    {
      "goal": "通过统一 Registry/CLI 直接运行 ScenarioSpec",
      "status": "planned",
      "modules": ["contracts:Registry", "contracts:ScenarioSpec"],
